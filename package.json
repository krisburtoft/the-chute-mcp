{
  "name": "the-chute-mcp-client",
  "version": "0.1.0",
  "description": "Open-source MCP server contracts, server adapter, and client for The Chute.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/krisburtoft/the-chute-mcp",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tools": {
      "types": "./dist/tool-catalog.d.ts",
      "import": "./dist/tool-catalog.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/discover-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
}
